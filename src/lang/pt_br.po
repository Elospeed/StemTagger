#: udankfenster.pas:109
msgid "StemTagger bleibt gratis, ohne Abo und ohne Werbung. Ich entwickle es in meiner Freizeit, mit viel Zeit und Herzblut."
msgstr "O StemTagger continua grátis, sem assinatura e sem anúncios. Eu o desenvolvo no meu tempo livre, com muito tempo e dedicação."

#: taggerform.pas:825
msgid "Tempo in Schlägen pro Minute, nur ganze Zahlen von %d bis %d, z.B. 128."
msgstr "Andamento em batidas por minuto, só números inteiros de %d a %d, ex.: 128."

#: taggerform.pas:524 taggerform.pas:859
msgid "Titel"
msgstr "Título"

#: taggerform.pas:532
