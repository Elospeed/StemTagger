msgstr "Tom"

#: taggerform.pas:828
msgid "Tonart des Tracks: aus der Liste wählen oder selbst eintippen."
msgstr "Tom da faixa: escolha da lista ou digite."

#: taggerform.pas:530
msgid "Track-Nr."
msgstr "Nº da faixa"

#: taggerform.pas:861
msgid "Traktor"
msgstr "Traktor"

#: taggerform.pas:827
msgid "Traktor misst das Tempo beim Analysieren ohnehin selbst."
msgstr "O Traktor mede o andamento sozinho ao analisar, de qualquer forma."

#: udankfenster.pas:114
msgid "Und wenn nicht, ist das völlig in Ordnung. Viel Spass beim Auflegen!"
msgstr "E se não, tudo bem. Bom set!"

#: udankfenster.pas:125
