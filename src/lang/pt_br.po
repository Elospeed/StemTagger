msgstr "Colar imagem da área de transferência (Ctrl+V)"

#: taggerform.pas:1843
msgid "Bild kann nicht gelesen werden:%s%s"
msgstr "Não é possível ler a imagem:%s%s"

#: taggerform.pas:771
msgid "Bild..."
msgstr "Imagem..."

#: taggerform.pas:2182
msgid "Bilder"
msgstr "Imagens"

