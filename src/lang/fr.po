msgstr "Artiste ou groupe, p. ex. « Kungs »"

#: taggerform.pas:533
msgid "Label"
msgstr "Label"

#: taggerform.pas:821
msgid "Leer lassen, wenn er gleich ist wie der Interpret."
msgstr "Laisser vide s'il est identique à l'artiste."

#: taggerform.pas:720
msgid "Legt vor dem ersten Speichern eine Kopie der Originaldatei an (Name.stem.mp4.bak)."
msgstr "Crée une copie du fichier d'origine avant le premier enregistrement (nom.stem.mp4.bak)."

#: taggerform.pas:677
msgid "Liste leeren"
msgstr "Vider la liste"

#: taggerform.pas:1539
