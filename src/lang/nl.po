#: udankfenster.pas:109
msgid "StemTagger bleibt gratis, ohne Abo und ohne Werbung. Ich entwickle es in meiner Freizeit, mit viel Zeit und Herzblut."
msgstr "StemTagger blijft gratis, zonder abonnement en zonder reclame. Ik ontwikkel het in mijn vrije tijd, met veel tijd en liefde."

#: taggerform.pas:825
msgid "Tempo in Schlägen pro Minute, nur ganze Zahlen von %d bis %d, z.B. 128."
msgstr "Tempo in slagen per minuut, alleen gehele getallen van %d tot %d, bijv. 128."

#: taggerform.pas:524 taggerform.pas:859
msgid "Titel"
msgstr "Titel"

#: taggerform.pas:532
