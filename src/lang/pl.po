#: taggerform.pas:734
msgid "  Camelot (Mixed In Key):  8A = a-Moll, 8B = C-Dur (A = Moll, B = Dur)"
msgstr "  Camelot (Mixed In Key):  8A = a-moll, 8B = C-dur (A = moll, B = dur)"

#: taggerform.pas:733
msgid "  Klassisch:  Am = a-Moll, C = C-Dur (m = Moll, ohne m = Dur)"
msgstr "  Klasyczny:  Am = a-moll, C = C-dur (m = moll, bez m = dur)"

#: taggerform.pas:735
msgid "  Open Key (Traktor):  1m = a-Moll, 1d = C-Dur (m = Moll, d = Dur)"
msgstr "  Open Key (Traktor):  1m = a-moll, 1d = C-dur (m = moll, d = dur)"

#: taggerform.pas:744
msgid "\"Interpret - Titel.stem.mp4\" füllt Interpret und Titel"
msgstr "„Wykonawca - Tytuł.stem.mp4” wypełnia wykonawcę i tytuł"

#: taggerform.pas:2220
msgid "%d Dateien aus dem Dateinamen übernommen - noch nicht gespeichert"
msgstr "Pliki uzupełnione z nazwy pliku: %d - jeszcze niezapisane"

#: taggerform.pas:1844
msgid "%d Dateien gespeichert"
msgstr "Zapisane pliki: %d"

#: taggerform.pas:1841
msgid "%d Dateien gespeichert, %d mit Fehler. Die Dateien mit Fehler sind unverändert, Details in der Spalte Status."
msgstr "Zapisane pliki: %d, z błędem: %d. Pliki z błędem są niezmienione, szczegóły w kolumnie Status."

#: taggerform.pas:1647
msgid "%d Dateien in der Liste."
msgstr "Plików na liście: %d."

#: taggerform.pas:1781
msgid "%d Dateien werden geändert."
msgstr "Pliki do zmiany: %d."

#: taggerform.pas:1453
msgid "%d Dateien, %d geändert"
msgstr "Pliki: %d, zmienione: %d"

#: taggerform.pas:2030
msgid "%d markierte Dateien haben ungespeicherte Änderungen. Trotzdem aus der Liste nehmen?"
msgstr "Zaznaczone pliki z niezapisanymi zmianami: %d. Mimo to usunąć z listy?"

#: taggerform.pas:1525 taggerform.pas:1554
msgid "<verschieden>"
msgstr "<różne>"

#: taggerform.pas:1650
msgid "Achtung bei Mehrfachauswahl: Sind mehrere Zeilen markiert, bekommen alle markierten Dateien den neuen Wert (z.B. alle dasselbe Album oder Cover). Felder mit „<verschieden>“ bleiben pro Datei erhalten, solange du sie nicht änderst."
msgstr "Uwaga przy zaznaczeniu wielu: gdy zaznaczonych jest kilka wierszy, wszystkie zaznaczone pliki dostają nową wartość (np. wszystkie ten sam album lub okładkę). Pola z „<różne>” zachowują wartość każdego pliku, dopóki ich nie zmienisz."

#: taggerform.pas:432 taggerform.pas:762
msgid "Album"
msgstr "Album"

#: taggerform.pas:721
msgid "Album, EP oder Single, auf der der Track erschienen ist"
msgstr "Album, EP lub singiel, na którym ukazał się utwór"

#: taggerform.pas:433
msgid "Album-Interpret"
msgstr "Wykonawca albumu"

#: taggerform.pas:1652
msgid "Audio, Stems und Traktors eigene Daten (auch in MP3s) bleiben immer unverändert, neu geschrieben werden nur die Tags."
msgstr "Dźwięk, stemy i własne dane Traktora (także w plikach MP3) zawsze pozostają bez zmian, zapisywane są tylko tagi."

#: taggerform.pas:437
msgid "BPM"
msgstr "BPM"

#: taggerform.pas:1771
msgid "BPM „%s“ bei %s ist ungültig. Bitte eine ganze Zahl von %d bis %d eingeben oder das Feld leeren."
msgstr "BPM „%s” w %s jest nieprawidłowe. Wpisz liczbę całkowitą od %d do %d lub wyczyść pole."

#: taggerform.pas:1648
msgid "Beim Laden wird nichts verändert. In die Dateien geschrieben wird erst mit „Speichern“, und nur bei Dateien mit Änderungen."
msgstr "Wczytanie niczego nie zmienia. Zapis do plików następuje dopiero po „Zapisz” i tylko w plikach ze zmianami."

#: taggerform.pas:738
msgid "Benachbarte Zahlen passen beim Mixen gut zusammen (z.B. 8A zu 7A, 9A und 8B)."
msgstr "Sąsiednie liczby dobrze się miksują (np. 8A z 7A, 9A i 8B)."

#: taggerform.pas:677
msgid "Bild aus der Zwischenablage einfügen (Strg+V)"
msgstr "Wklej obraz ze schowka (Ctrl+V)"

#: taggerform.pas:1733
msgid "Bild kann nicht gelesen werden:%s%s"
msgstr "Nie można odczytać obrazu:%s%s"

#: taggerform.pas:673
msgid "Bild..."
msgstr "Obraz..."

#: taggerform.pas:2066
msgid "Bilder"
msgstr "Obrazy"

#: taggerform.pas:442 taggerform.pas:762
msgid "Cover"
msgstr "Okładka"

#: taggerform.pas:2172
msgid "Cover speichern"
msgstr "Zapisz okładkę"

#: taggerform.pas:2065
msgid "Cover-Bild wählen"
msgstr "Wybierz obraz okładki"

#: taggerform.pas:2145
msgid "Das Bild aus der Zwischenablage kann nicht gelesen werden."
msgstr "Nie można odczytać obrazu ze schowka."

#: taggerform.pas:761
msgid "Datei"
msgstr "Plik"

#: taggerform.pas:1978
msgid "Dateien öffnen"
msgstr "Otwórz pliki"

#: taggerform.pas:580
msgid "Dateien..."
msgstr "Pliki..."

#: taggerform.pas:623
msgid "Die Kopie wird nie überschrieben, sie bleibt also das echte Original."
msgstr "Kopia nigdy nie jest nadpisywana, więc pozostaje prawdziwym oryginałem."

#: taggerform.pas:737
msgid "Die Liste zeigt alle drei, gespeichert wird die klassische (z.B. Am)."
msgstr "Lista pokazuje wszystkie trzy, zapisywany jest zapis klasyczny (np. Am)."

#: taggerform.pas:1741
msgid "Dieses Bildformat wird nicht unterstützt. Bitte JPEG, PNG, BMP oder GIF verwenden."
msgstr "Ten format obrazu nie jest obsługiwany. Użyj JPEG, PNG, BMP lub GIF."

#: taggerform.pas:779
msgid "Doppelklick auf den Rand passt die Spalte an den Text an"
msgstr "Dwuklik na krawędzi dopasowuje kolumnę do tekstu"

#: taggerform.pas:674
msgid "Einfügen"
msgstr "Wklej"

#: taggerform.pas:582 taggerform.pas:675
msgid "Entfernen"
msgstr "Usuń"

#: taggerform.pas:725
msgid "Erscheinungsjahr, z.B. 2016"
msgstr "Rok wydania, np. 2016"

#: taggerform.pas:732
msgid "Es gibt drei übliche Schreibweisen für dieselbe Tonart:"
msgstr "Ta sama tonacja ma trzy popularne zapisy:"

#: taggerform.pas:2303
msgid "Es gibt ungespeicherte Änderungen. Jetzt speichern?"
msgstr "Są niezapisane zmiany. Zapisać teraz?"

#: taggerform.pas:2050
msgid "Es gibt ungespeicherte Änderungen. Liste trotzdem leeren?"
msgstr "Są niezapisane zmiany. Mimo to wyczyścić listę?"

#: taggerform.pas:1829
msgid "Fehler: "
msgstr "Błąd: "

#: taggerform.pas:1799
msgid "Fehler: Sicherungskopie nicht möglich"
msgstr "Błąd: nie można utworzyć kopii zapasowej"

#: taggerform.pas:740
msgid "Freier Text, z.B. Notizen fürs Auflegen"
msgstr "Dowolny tekst, np. notatki do grania"

#: taggerform.pas:434 taggerform.pas:762
msgid "Genre"
msgstr "Gatunek"

#: taggerform.pas:1824
msgid "Gespeichert"
msgstr "Zapisano"

#: taggerform.pas:627
msgid "Grosse Cover auf %d px verkleinern"
msgstr "Zmniejszaj duże okładki do %d px"

#: taggerform.pas:1311
msgid "Im Ordner wurden keine Stem- oder MP3-Dateien gefunden:%s%s"
msgstr "W folderze nie znaleziono plików stem ani MP3:%s%s"

#: taggerform.pas:2129
msgid "In der Zwischenablage ist kein Bild."
msgstr "W schowku nie ma obrazu."

#: taggerform.pas:431 taggerform.pas:761
msgid "Interpret"
msgstr "Wykonawca"

#: taggerform.pas:722
msgid "Interpret des ganzen Albums, z.B. „Various Artists“ bei Compilations."
msgstr "Wykonawca całego albumu, np. „Various Artists” przy kompilacjach."

#: taggerform.pas:741
msgid "Interpret/Titel aus Dateiname"
msgstr "Wykonawca/tytuł z nazwy"

#: taggerform.pas:435
msgid "Jahr"
msgstr "Rok"

#: taggerform.pas:1783
msgid "Jetzt speichern?"
msgstr "Zapisać teraz?"

#: taggerform.pas:609 taggerform.pas:1622
msgid "Kaffee spendieren"
msgstr "Postaw kawę"

#: taggerform.pas:1368
msgid "Keine Stem-Datei"
msgstr "To nie plik stem"

#: taggerform.pas:777
msgid "Klick sortiert, nochmal klicken sortiert umgekehrt"
msgstr "Kliknięcie sortuje, ponowne kliknięcie odwraca kolejność"

#: taggerform.pas:440
msgid "Kommentar"
msgstr "Komentarz"

#: taggerform.pas:720
msgid "Künstler oder Band, z.B. „Kungs“"
msgstr "Wykonawca lub zespół, np. „Kungs”"

#: taggerform.pas:439
msgid "Label"
msgstr "Wytwórnia"

#: taggerform.pas:723
msgid "Leer lassen, wenn er gleich ist wie der Interpret."
msgstr "Zostaw puste, jeśli jest taki sam jak wykonawca."

#: taggerform.pas:622
msgid "Legt vor dem ersten Speichern eine Kopie der Originaldatei an (Name.stem.mp4.bak)."
msgstr "Przed pierwszym zapisem tworzy kopię pliku oryginalnego (nazwa.stem.mp4.bak)."

#: taggerform.pas:583
msgid "Liste leeren"
msgstr "Wyczyść listę"

#: taggerform.pas:1429
msgid "MP3 OK"
msgstr "MP3 OK"

#: taggerform.pas:1427
msgid "MP3 OK, mit Traktor-Daten"
msgstr "MP3 OK, z danymi Traktora"

#: taggerform.pas:1981
msgid "MP3-Dateien"
msgstr "Pliki MP3"

#: taggerform.pas:1982
msgid "MP4-Dateien"
msgstr "Pliki MP4"

#: taggerform.pas:724
msgid "Musikstil: aus der Liste wählen oder selbst eintippen"
msgstr "Styl muzyczny: wybierz z listy lub wpisz własny"

#: taggerform.pas:719
msgid "Name des Tracks, z.B. „Clap Your Hands“"
msgstr "Nazwa utworu, np. „Clap Your Hands”"

#: taggerform.pas:1782
msgid "Neu geschrieben werden nur die geänderten Tags, Audio, Stems und Traktor-Daten bleiben unverändert."
msgstr "Zapisywane są tylko zmienione tagi, dźwięk, stemy i dane Traktora pozostają bez zmian."

#: taggerform.pas:1345 taggerform.pas:1364 taggerform.pas:1376
msgid "Nicht lesbar"
msgstr "Nieczytelny"

#: taggerform.pas:1653
msgid "Nicht mehr anzeigen"
msgstr "Nie pokazuj więcej"

#: taggerform.pas:726
msgid "Nummer auf dem Album, z.B. 3 oder 3/12 (Track 3 von 12)"
msgstr "Numer na albumie, np. 3 lub 3/12 (utwór 3 z 12)"

#: taggerform.pas:1351
msgid "Nur lesen (alter oder beschädigter ID3-Tag)"
msgstr "Tylko do odczytu (stary lub uszkodzony tag ID3)"

#: taggerform.pas:1425
msgid "Ohne Cover"
msgstr "Bez okładki"

#: taggerform.pas:1422
msgid "Ohne Tags"
msgstr "Bez tagów"

#: taggerform.pas:1420
msgid "Ohne Tags und Cover"
msgstr "Bez tagów i okładki"

#: taggerform.pas:1646
msgid "Ordner geladen"
msgstr "Folder wczytany"

#: taggerform.pas:2006
msgid "Ordner mit Stem- oder MP3-Dateien wählen (mit Unterordnern)"
msgstr "Wybierz folder z plikami stem lub MP3 (z podfolderami)"

#: taggerform.pas:581
msgid "Ordner..."
msgstr "Folder..."

#: taggerform.pas:739
msgid "Plattenfirma, die den Track veröffentlicht hat"
msgstr "Wytwórnia płytowa, która wydała utwór"

#: taggerform.pas:778
msgid "Rand zwischen zwei Spalten ziehen ändert die Breite"
msgstr "Przeciągnij krawędź między dwiema kolumnami, aby zmienić szerokość"

#: taggerform.pas:621
msgid "Sicherungskopie anlegen (.bak)"
msgstr "Utwórz kopię zapasową (.bak)"

#: taggerform.pas:1791
msgid "Speichere %s ..."
msgstr "Zapisywanie %s ..."

#: taggerform.pas:592
msgid "Speichern"
msgstr "Zapisz"

#: taggerform.pas:676
msgid "Speichern..."
msgstr "Zapisz..."

#: taggerform.pas:763
msgid "Status"
msgstr "Status"

#: taggerform.pas:1431
msgid "Stem OK (%d Spuren)"
msgstr "Stem OK (ścieżki: %d)"

#: taggerform.pas:1979
msgid "Stem- und MP3-Dateien"
msgstr "Pliki stem i MP3"

#: taggerform.pas:1980
msgid "Stem-Dateien"
msgstr "Pliki stem"

#: taggerform.pas:1451
msgid "Stem-Dateien, MP3s oder Ordner hierher ziehen"
msgstr "Przeciągnij tutaj pliki stem, MP3 lub foldery"

#: taggerform.pas:727
msgid "Tempo in Schlägen pro Minute, nur ganze Zahlen von %d bis %d, z.B. 128."
msgstr "Tempo w uderzeniach na minutę, tylko liczby całkowite od %d do %d, np. 128."

#: taggerform.pas:430 taggerform.pas:761
msgid "Titel"
msgstr "Tytuł"

#: taggerform.pas:438
msgid "Tonart"
msgstr "Tonacja"

#: taggerform.pas:730
msgid "Tonart des Tracks: aus der Liste wählen oder selbst eintippen."
msgstr "Tonacja utworu: wybierz z listy lub wpisz własną."

#: taggerform.pas:436
msgid "Track-Nr."
msgstr "Nr utworu"

#: taggerform.pas:763
msgid "Traktor"
msgstr "Traktor"

#: taggerform.pas:729
msgid "Traktor misst das Tempo beim Analysieren ohnehin selbst."
msgstr "Traktor i tak sam mierzy tempo podczas analizy."

#: taggerform.pas:2267
msgid "Zuerst die Dateien markieren, die dieses Cover bekommen sollen."
msgstr "Najpierw zaznacz pliki, które mają otrzymać tę okładkę."

#: taggerform.pas:1413
msgid "geändert"
msgstr "zmieniony"

#: taggerform.pas:1401 taggerform.pas:1407
msgid "ja"
msgstr "tak"

#: taggerform.pas:1672
msgid "kein Cover"
msgstr "brak okładki"

#: taggerform.pas:591
msgid "Änderungen verwerfen"
msgstr "Odrzuć zmiany"

