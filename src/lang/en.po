msgid "Bild kann nicht gelesen werden:%s%s"
msgstr "Cannot read picture:%s%s"

#: taggerform.pas:675
msgid "Bild..."
msgstr "Picture..."

#: taggerform.pas:2074
msgid "Bilder"
msgstr "Pictures"

