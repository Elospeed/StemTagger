msgstr "Open stem files"

#: taggerform.pas:701
msgid "Tempo in Schlägen pro Minute, nur ganze Zahlen von %d bis %d, z.B. 128."
msgstr "Tempo in beats per minute, whole numbers from %d to %d only, e.g. 128."

#: taggerform.pas:409 taggerform.pas:732
msgid "Titel"
msgstr "Title"

#: taggerform.pas:417
