msgstr "Scegli una cartella con file stem o MP3 (incluse le sottocartelle)"

#: taggerform.pas:583
msgid "Ordner..."
msgstr "Cartella..."

#: taggerform.pas:741
msgid "Plattenfirma, die den Track veröffentlicht hat"
msgstr "Etichetta discografica che ha pubblicato la traccia"

#: taggerform.pas:786
msgid "Rand zwischen zwei Spalten ziehen ändert die Breite"
msgstr "Trascina il bordo tra due colonne per cambiare la larghezza"

#: taggerform.pas:623
msgid "Sicherungskopie anlegen (.bak)"
msgstr "Crea copia di sicurezza (.bak)"

#: taggerform.pas:1799
msgid "Speichere %s ..."
msgstr "Salvataggio di %s ..."

#: taggerform.pas:594
msgid "Speichern"
msgstr "Salva"

#: taggerform.pas:678
msgid "Speichern..."
msgstr "Salva..."

#: taggerform.pas:765
msgid "Status"
msgstr "Stato"

#: taggerform.pas:1439
msgid "Stem OK (%d Spuren)"
msgstr "Stem OK (%d tracce)"

#: taggerform.pas:1987
msgid "Stem- und MP3-Dateien"
msgstr "File stem e MP3"

#: taggerform.pas:1988
msgid "Stem-Dateien"
msgstr "File stem"

#: taggerform.pas:1459
msgid "Stem-Dateien, MP3s oder Ordner hierher ziehen"
msgstr "Trascina qui file stem, MP3 o cartelle"

#: taggerform.pas:729
msgid "Tempo in Schlägen pro Minute, nur ganze Zahlen von %d bis %d, z.B. 128."
msgstr "Tempo in battiti al minuto, solo numeri interi da %d a %d, ad es. 128."

#: taggerform.pas:432 taggerform.pas:763
msgid "Titel"
msgstr "Titolo"

#: taggerform.pas:440
